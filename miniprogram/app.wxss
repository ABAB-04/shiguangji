/* ==================== 食光机 - 全局样式 ==================== */

/* CSS 变量 */
page {
  --bg-dark: #1a1a1a;
  --bg-card: #2a2a2a;
  --primary: #d4a574;
  --secondary: #8b7355;
  --accent: #e8944a;
  --text: #f0f0f0;
  --textDark: #2c2c2c;
  --textLight: #888888;
  --cardBg: #f4f1ea;
  --border: #3a3a3a;
  --shadow: 0 4rpx 20rpx rgba(0,0,0,0.3);
  --radius: 16rpx;
  --radius-sm: 8rpx;
  background-color: var(--bg-dark);
  color: var(--text);
  font-size: 28rpx;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', sans-serif;
  line-height: 1.6;
}

/* ======== Flex 布局 ======== */
.flex { display: flex; }
.flex-col { display: flex; flex-direction: column; }
.flex-center { display: flex; align-items: center; justify-content: center; }
.flex-between { display: flex; align-items: center; justify-content: space-between; }
.flex-1 { flex: 1; }
.flex-wrap { flex-wrap: wrap; }

/* ======== 间距 ======== */
.p-20 { padding: 20rpx; }
.p-30 { padding: 30rpx; }
.p-40 { padding: 40rpx; }
.pt-20 { padding-top: 20rpx; }
.pb-20 { padding-bottom: 20rpx; }
.mt-10 { margin-top: 10rpx; }
.mt-20 { margin-top: 20rpx; }
.mt-30 { margin-top: 30rpx; }
.mb-20 { margin-bottom: 20rpx; }
.mb-30 { margin-bottom: 30rpx; }
.mx-40 { margin-left: 40rpx; margin-right: 40rpx; }

/* ======== 文字 ======== */
.text-center { text-align: center; }
.text-left { text-align: left; }
.text-right { text-align: right; }
.text-primary { color: var(--primary); }
.text-light { color: var(--textLight); }
.text-sm { font-size: 24rpx; }
.text-lg { font-size: 36rpx; }
.text-xl { font-size: 44rpx; }
.text-bold { font-weight: bold; }
.text-ellipsis { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.text-clamp2 { overflow: hidden; text-overflow: ellipsis; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }

/* ======== 卡片 ======== */
.card {
  background: var(--bg-card);
  border-radius: var(--radius);
  overflow: hidden;
}
.card-light {
  background: var(--cardBg);
  border-radius: var(--radius);
  overflow: hidden;
}

/* ======== 图片 ======== */
.img-cover {
  width: 100%;
  height: 100%;
}
.img-radius {
  border-radius: var(--radius);
  overflow: hidden;
}

/* ======== 按钮 ======== */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx 40rpx;
  border-radius: var(--radius);
  font-size: 28rpx;
  font-weight: 500;
}
.btn-primary {
  background: var(--primary);
  color: #fff;
}
.btn-outline {
  border: 2rpx solid var(--primary);
  color: var(--primary);
  background: transparent;
}
.btn-sm {
  padding: 10rpx 24rpx;
  font-size: 24rpx;
}
.btn-lg {
  padding: 24rpx 60rpx;
  font-size: 32rpx;
}

/* ======== 标签 ======== */
.tag {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  background: rgba(212, 165, 116, 0.15);
  color: var(--primary);
}

/* ======== 分隔线 ======== */
.divider {
  height: 1rpx;
  background: var(--border);
  margin: 20rpx 0;
}

/* ======== 安全区 ======== */
.safe-bottom {
  padding-bottom: calc(env(safe-area-inset-bottom) + 20rpx);
}

/* ======== 页面通用容器 ======== */
.page-container {
  min-height: 100vh;
  padding-top: calc(var(--navBarHeight, 88rpx));
  box-sizing: border-box;
}

/* ======== 动画 ======== */
@keyframes fadeIn {
  from { opacity: 0; transform: translateY(20rpx); }
  to { opacity: 1; transform: translateY(0); }
}
.fade-in {
  animation: fadeIn 0.4s ease-out;
}

@keyframes shimmer {
  0% { background-position: -200% 0; }
  100% { background-position: 200% 0; }
}
.skeleton-shimmer {
  background: linear-gradient(90deg, var(--bg-card) 25%, #3a3a3a 50%, var(--bg-card) 75%);
  background-size: 200% 100%;
  animation: shimmer 1.5s infinite;
}

/* ======== 空状态 ======== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 40rpx;
}
.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}
.empty-text {
  font-size: 28rpx;
  color: var(--textLight);
}
