/* film-card 组件样式 - 继承全局 */

/* 图片容器 */
.film-image-wrapper {
  width: 100%;
  min-height: 120px;
  position: relative;
  overflow: hidden;
  border-radius: 2px;
}

/* 加载占位 */
.film-loading-placeholder {
  width: 100%;
  aspect-ratio: 4/3;
  min-height: 120px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.film-loading-icon {
  font-size: 40px;
  opacity: 0.6;
}

/* 图片渐进式加载 */
.film-image {
  width: 100%;
  opacity: 0;
  transition: opacity 0.3s ease-in-out;
}

.film-image.loaded {
  opacity: 1;
}

/* 图片加载失败时的占位渐变块 */
.film-placeholder {
  width: 100%;
  aspect-ratio: 4/3;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 2px;
  min-height: 120px;
}

.film-placeholder-icon {
  font-size: 40px;
  opacity: 0.7;
}
