/* 骨架屏组件样式 */
.skeleton-container {
  padding: 16px;
}

/* ===== 动画基础 ===== */
.skeleton-pulse {
  animation: skeleton-pulse 1.5s ease-in-out infinite;
}

@keyframes skeleton-pulse {
  0%, 100% { opacity: 0.4; }
  50% { opacity: 0.7; }
}

/* ===== 日历骨架屏 ===== */
.skeleton-calendar {
  padding: 0 12px;
}

.skeleton-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 10px 8px 16px;
}

.skeleton-arrow {
  width: 36px;
  height: 36px;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.06);
}

.skeleton-title {
  width: 120px;
  height: 20px;
  border-radius: 4px;
  background: rgba(255, 255, 255, 0.06);
}

.skeleton-weekdays {
  display: flex;
  margin-bottom: 6px;
}

.skeleton-weekday {
  flex: 1;
  height: 18px;
  margin: 6px 2px;
  border-radius: 2px;
  background: rgba(255, 255, 255, 0.04);
}

.skeleton-grid {
  display: flex;
  flex-wrap: wrap;
}

.skeleton-cell {
  width: calc(100% / 7);
  aspect-ratio: 1;
  margin: 3px;
  border-radius: 10px;
  background: rgba(255, 255, 255, 0.06);
}

/* ===== 列表骨架屏 ===== */
.skeleton-list {
  padding: 0 4px;
}

.skeleton-carousel {
  width: 100%;
  height: 200px;
  border-radius: 12px;
  background: rgba(255, 255, 255, 0.06);
  margin-bottom: 16px;
}

.skeleton-section-title {
  width: 80px;
  height: 20px;
  border-radius: 4px;
  background: rgba(255, 255, 255, 0.06);
  margin: 12px 8px 16px;
}

.skeleton-waterfall {
  display: flex;
  gap: 8px;
}

.skeleton-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.skeleton-card {
  width: 100%;
  border-radius: 12px;
  background: rgba(255, 255, 255, 0.06);
  margin-bottom: 8px;
}

/* 所有骨架元素添加脉冲动画 */
.skeleton-arrow,
.skeleton-title,
.skeleton-weekday,
.skeleton-cell,
.skeleton-carousel,
.skeleton-section-title,
.skeleton-card {
  animation: skeleton-pulse 1.5s ease-in-out infinite;
}