/* top-nav 组件样式 */

.top-nav {
  position: sticky;
  top: 0;
  background: rgba(26, 26, 26, 0.97);
  backdrop-filter: blur(12px);
  padding: 12px 16px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  z-index: 100;
  border-bottom: 1px solid rgba(255, 255, 255, 0.06);
}

/* ===== 左右装饰区 ===== */
.top-nav-left, .top-nav-right {
  width: 56px;
  display: flex;
  align-items: center;
}
.top-nav-left { justify-content: flex-start; }
.top-nav-right { justify-content: flex-end; }

.nav-deco-left, .nav-deco-right {
  display: flex;
  align-items: center;
  gap: 6px;
  opacity: 0.4;
}
.nav-deco-dot {
  font-size: 6px;
  color: var(--accent);
}
.nav-deco-line {
  width: 16px;
  height: 1px;
  background: linear-gradient(to right, var(--accent), transparent);
}
.nav-deco-right .nav-deco-line {
  background: linear-gradient(to left, var(--accent), transparent);
}

/* ===== 返回按钮 ===== */
.back-btn {
  display: flex;
  align-items: center;
  gap: 2px;
  color: var(--accent);
}
.back-arrow {
  font-size: 26px;
  font-weight: 300;
  line-height: 1;
  margin-top: -2px;
}
.back-text {
  font-size: 14px;
}

/* ===== 菜单按钮 ===== */
.menu-btn {
  width: 24px;
  height: 24px;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 4px;
}
.menu-btn-line {
  display: block;
  width: 100%;
  height: 2px;
  background: var(--accent);
  border-radius: 2px;
}
.menu-btn-line.short {
  width: 60%;
}

/* ===== 中间标题区 ===== */
.top-nav-center {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2px;
}

.nav-icon {
  font-size: 16px;
  line-height: 1;
}

.top-nav-title {
  font-size: 15px;
  color: var(--accent);
  letter-spacing: 3px;
  font-weight: 500;
}

.nav-ornament {
  display: flex;
  align-items: center;
  gap: 8px;
  opacity: 0.35;
  margin-top: 1px;
}
.ornament-dot {
  font-size: 10px;
  color: var(--accent);
}
.ornament-diamond {
  font-size: 5px;
  color: var(--accent);
}
