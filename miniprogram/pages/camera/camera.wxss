/* 食光机 - 拍照记录页样式 */
@import '/app.wxss';

/* 全屏布局 */
.page-container.no-tab {
  position: fixed;
  inset: 0;
  background: #000;
  display: flex;
  flex-direction: column;
  z-index: 2000;
  padding-bottom: 0;
}

/* ===== 拍照模式 ===== */
.cam-preview {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #1a1a1a;
  position: relative;
  overflow: hidden;
}

.cam-preview-img {
  width: 100%;
  height: 100%;
}

.cam-placeholder {
  text-align: center;
  color: #666;
}
.cam-placeholder-icon { font-size: 60px; }
.cam-placeholder-text { display: block; font-size: 16px; margin-top: 16px; color: #888; }
.cam-placeholder-sub { display: block; font-size: 13px; margin-top: 8px; color: #555; }

/* 底部控制栏 */
.cam-footer {
  padding: 20px 24px 44px;
  background: rgba(0, 0, 0, 0.95);
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-shrink: 0;
}

.cam-shutter {
  width: 74px;
  height: 74px;
  border-radius: 50%;
  border: 4px solid rgba(255, 255, 255, 0.85);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.cam-shutter:active { transform: scale(0.92); }
.cam-shutter-inner {
  width: 58px;
  height: 58px;
  border-radius: 50%;
  background: #fff;
}

.cam-gallery-btn {
  color: #aaa;
  font-size: 14px;
  padding: 10px 16px;
  display: flex;
  align-items: center;
  gap: 4px;
}
.cam-gallery-btn:active { color: #fff; }

.cam-close-btn {
  color: #888;
  font-size: 14px;
  padding: 10px 16px;
  display: flex;
  align-items: center;
  gap: 4px;
}
.cam-close-btn:active { color: #fff; }

/* ===== 编辑模式 ===== */
.edit-header {
  padding: 14px 20px;
  background: rgba(0, 0, 0, 0.95);
  flex-shrink: 0;
  text-align: center;
  border-bottom: 1px solid rgba(255, 255, 255, 0.06);
}
.edit-header-title {
  color: #fff;
  font-size: 17px;
  font-weight: 500;
  letter-spacing: 2px;
}

.edit-scroll {
  flex: 1;
  padding: 16px 20px;
}

.edit-image {
  width: 100%;
  border-radius: 16px;
  margin-bottom: 20px;
}

.edit-section {
  margin-bottom: 24px;
}
.edit-section-title {
  color: var(--accent);
  font-size: 14px;
  margin-bottom: 12px;
  letter-spacing: 1px;
}

/* 色卡 */
.pal-colors {
  display: flex;
  gap: 10px;
  flex-wrap: wrap;
}
.pal-color-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6px;
}
.pal-color-dot {
  width: 48px;
  height: 48px;
  border-radius: 50%;
  border: 2.5px solid #fff;
  box-shadow: 0 3px 10px rgba(0, 0, 0, 0.4);
}
.pal-color-code {
  font-size: 10px;
  color: #888;
  font-family: monospace;
}

/* 输入框 */
.food-input {
  width: 100%;
  background: rgba(255, 255, 255, 0.06);
  border: 1px solid rgba(212, 165, 116, 0.3);
  border-radius: 12px;
  padding: 16px;
  color: #fff;
  font-size: 15px;
  margin-bottom: 12px;
  box-sizing: border-box;
}
.food-input::placeholder { color: #555; }

.food-textarea {
  width: 100%;
  background: rgba(255, 255, 255, 0.06);
  border: 1px solid rgba(212, 165, 116, 0.3);
  border-radius: 12px;
  padding: 14px 16px;
  color: #fff;
  font-size: 15px;
  min-height: 100px;
  box-sizing: border-box;
}
.food-textarea::placeholder { color: #555; }

/* ===== 心情选择 ===== */
.mood-row {
  display: flex;
  gap: 6px;
  margin-bottom: 14px;
  flex-wrap: wrap;
}
.mood-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4px;
  padding: 10px 12px;
  border-radius: 14px;
  border: 1.5px solid rgba(255, 255, 255, 0.08);
  background: rgba(255, 255, 255, 0.03);
  min-width: 52px;
  transition: all 0.2s;
}
.mood-item.active {
  border-color: var(--accent);
  background: rgba(212, 165, 116, 0.15);
}
.mood-item:active { transform: scale(0.95); }
.mood-emoji { font-size: 26px; }
.mood-label { font-size: 10px; color: #888; }
.mood-item.active .mood-label { color: var(--accent); }

.feeling-textarea {
  min-height: 80px;
}

/* ===== 底部按钮栏 ===== */
.edit-bottom-bar {
  display: flex;
  gap: 14px;
  padding: 16px 20px 36px;
  background: rgba(0, 0, 0, 0.95);
  border-top: 1px solid rgba(255, 255, 255, 0.08);
  flex-shrink: 0;
}

.edit-btn {
  flex: 1;
  text-align: center;
  padding: 14px;
  border-radius: 14px;
  font-size: 15px;
  font-weight: 500;
}
.edit-btn.back {
  background: rgba(255, 255, 255, 0.06);
  color: #999;
  border: 1px solid rgba(255, 255, 255, 0.1);
}
.edit-btn.back:active { background: rgba(255, 255, 255, 0.12); }
.edit-btn.save {
  background: rgba(212, 165, 116, 0.2);
  color: var(--accent);
  border: 1px solid rgba(212, 165, 116, 0.4);
}
.edit-btn.save:active { background: rgba(212, 165, 116, 0.35); }
.edit-btn.disabled {
  opacity: 0.5;
  pointer-events: none;
}

/* ===== 盲盒弹窗 ===== */
.blindbox-overlay {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.85);
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40px;
}
.blindbox-card {
  background: #1e1e1e;
  border: 1px solid rgba(212, 165, 116, 0.25);
  border-radius: 24px;
  padding: 36px 28px 28px;
  text-align: center;
  width: 100%;
  max-width: 320px;
  animation: boxPop 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
}
@keyframes boxPop {
  from { transform: scale(0.7); opacity: 0; }
  to { transform: scale(1); opacity: 1; }
}
.blindbox-emoji { font-size: 56px; margin-bottom: 16px; }
.blindbox-tag { font-size: 20px; font-weight: 600; color: #fff; margin-bottom: 10px; letter-spacing: 1px; }
.blindbox-desc { font-size: 15px; color: #999; line-height: 1.6; margin-bottom: 24px; }
.blindbox-confirm {
  display: inline-block;
  padding: 12px 40px;
  background: rgba(212, 165, 116, 0.15);
  border: 1px solid rgba(212, 165, 116, 0.3);
  color: var(--accent);
  border-radius: 24px;
  font-size: 15px;
}
.blindbox-confirm:active { background: rgba(212, 165, 116, 0.3); }
