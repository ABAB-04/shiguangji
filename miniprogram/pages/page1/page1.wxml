<!-- 顶部导航 -->
<top-nav title="食光机" showBack="{{false}}"></top-nav>

<!-- 问候区 -->
<view class="greeting-section">
  <text class="greeting">{{greeting}}</text>
  <text class="greeting-sub">{{greetingSub}}</text>
</view>

<!-- 视图切换 -->
<view class="view-toggle">
  <view class="toggle-item {{viewMode === 'calendar' ? 'active' : ''}}" bindtap="switchView" data-mode="calendar">
    <text>📅 日历</text>
  </view>
  <view class="toggle-item {{viewMode === 'list' ? 'active' : ''}}" bindtap="switchView" data-mode="list">
    <text>📋 列表</text>
  </view>
</view>

<!-- 加载骨架屏 -->
<view wx:if="{{isLoading}}">
  <skeleton></skeleton>
</view>

<!-- 日历视图 -->
<view wx:elif="{{viewMode === 'calendar'}}" class="calendar-container">
  <view class="calendar-header">
    <view class="cal-nav" bindtap="prevMonth">◀</view>
    <view class="cal-title">{{calYear}}年{{calMonth}}月 · {{foodCount}}条记录</view>
    <view class="cal-nav" bindtap="nextMonth">▶</view>
  </view>

  <!-- 星期 -->
  <view class="week-row">
    <view class="week-day" wx:for="{{weekDays}}" wx:key="*this">{{item}}</view>
  </view>

  <!-- 日期 -->
  <view class="day-grid">
    <view
      class="day-cell {{item.month}} {{item.hasFood ? 'has-food' : ''}}"
      wx:for="{{calendarDays}}"
      wx:key="date"
      data-date="{{item.date}}"
      bindtap="onDayTap"
    >
      <text class="day-num">{{item.day}}</text>
      <view class="day-dot" wx:if="{{item.hasFood}}"></view>
    </view>
  </view>

  <!-- 选中的食物卡片 -->
  <view class="selected-food" wx:if="{{selectedDayFood}}">
    <film-card food="{{selectedDayFood}}"></film-card>
  </view>
  <view class="no-food" wx:else>
    <text>👆 点击有标记的日期查看详情</text>
  </view>
</view>

<!-- 列表视图 -->
<view wx:else class="list-container">
  <!-- Banner -->
  <swiper class="banner-swiper" wx:if="{{banners.length > 0}}" indicator-dots="{{true}}" autoplay="{{true}}" interval="{{3000}}" circular="{{true}}">
    <swiper-item wx:for="{{banners}}" wx:key="_id">
      <image class="banner-img" src="{{item.image}}" mode="aspectFill"></image>
    </swiper-item>
  </swiper>

  <!-- 瀑布流 -->
  <view class="waterfall">
    <view class="col-left">
      <film-card wx:for="{{leftFoods}}" wx:key="_id" food="{{item}}"></film-card>
    </view>
    <view class="col-right">
      <film-card wx:for="{{rightFoods}}" wx:key="_id" food="{{item}}"></film-card>
    </view>
  </view>
</view>

<!-- Toast -->
<toast text="{{toastText}}" show="{{toastShow}}"></toast>
