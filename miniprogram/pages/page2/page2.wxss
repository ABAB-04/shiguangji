/* 食光机 - 美食图鉴页样式 */
@import '/app.wxss';

/* 拍照入口卡片 */
.add-food-card {
  margin: 12px 16px 4px;
  padding: 20px;
  border: 2px dashed rgba(212, 165, 116, 0.4);
  border-radius: 16px;
  text-align: center;
  background: rgba(212, 165, 116, 0.06);
  transition: all 0.3s;
}

.add-food-card:active {
  background: rgba(212, 165, 116, 0.15);
  transform: scale(0.98);
}

.add-food-icon {
  font-size: 36px;
  margin-bottom: 8px;
}

.add-food-text {
  font-size: 16px;
  color: var(--accent);
  font-weight: 500;
  letter-spacing: 2px;
}

.add-food-sub {
  font-size: 12px;
  color: #666;
  margin-top: 4px;
}

/* 加载更多提示 */
.load-more-tip {
  text-align: center;
  padding: 20px;
  color: #666;
  font-size: 13px;
}

.no-more-tip {
  text-align: center;
  padding: 20px;
  color: #555;
  font-size: 12px;
}

/* 空状态 */
.empty-tip {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40px 20px;
}

.empty-icon {
  font-size: 48px;
  opacity: 0.6;
  margin-bottom: 12px;
}

.empty-text {
  font-size: 15px;
  color: #888;
  margin-bottom: 8px;
}

.empty-sub {
  font-size: 12px;
  color: #555;
}

/* 操作按钮 */
.detail-actions {
  margin-top: 30px;
  padding-top: 20px;
  border-top: 1px solid rgba(255, 255, 255, 0.06);
  display: flex;
  gap: 14px;
  justify-content: center;
}

.share-btn {
  padding: 12px 24px;
  border: 1px solid rgba(212, 165, 116, 0.4);
  border-radius: 20px;
  color: var(--accent);
  font-size: 14px;
  background: rgba(212, 165, 116, 0.08);
}

.share-btn:active {
  background: rgba(212, 165, 116, 0.2);
}

.delete-btn {
  padding: 12px 24px;
  border: 1px solid rgba(232, 148, 74, 0.35);
  border-radius: 20px;
  color: var(--accent);
  font-size: 14px;
}

.delete-btn:active {
  background: rgba(201, 48, 44, 0.1);
}
